# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Banco (Neon) – use a URL "pooled" do branch dev para desenvolvimento
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/cofre?sslmode=require

# Criptografia (gerar com: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())")
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
JWT_SECRET=

# Sessão
ACCESS_TOKEN_MINUTES=15

# Portal do cliente (em produção: URL do Render, ex. https://cofre-z4.onrender.com)
PUBLIC_URL=http://localhost:8000
PORTAL_LINK_HOURS=24

# E-mail: Mailpit em dev; Resend em produção
SMTP_HOST=mailpit
SMTP_PORT=1025
RESEND_API_KEY=
MAIL_FROM=nao-responda@z4motors.local

# Job de anonimização chamado pelo GitHub Actions
CRON_SECRET=

# LGPD
RETENTION_DAYS=180
