# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Banco
POSTGRES_USER=cofre
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cofre
DATABASE_URL=postgresql+psycopg://cofre:troque-esta-senha@db:5432/cofre

# Criptografia (gerar com: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())")
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
JWT_SECRET=

# Sessão
ACCESS_TOKEN_MINUTES=15

# Portal do cliente (atualizar com o link do túnel no dia da apresentação)
PUBLIC_URL=http://localhost:5173
PORTAL_LINK_HOURS=24

# E-mail (Mailpit em dev)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=nao-responda@z4motors.local

# LGPD
RETENTION_DAYS=180
